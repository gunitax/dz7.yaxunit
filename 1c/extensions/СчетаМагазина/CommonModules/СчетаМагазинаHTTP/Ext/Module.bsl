///////////////////////////////////////////////////////////////////////////////////////////////////////
// Обработчики HTTP-сервиса «СчетаМагазина».
// Модуль сервиса передает запросы сюда; тесты вызывают функции напрямую с заглушкой запроса.
///////////////////////////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Возвращает реестр поддерживаемых типов, отфильтрованный по строке q.
//
// Параметры:
//  Запрос - HTTPСервисЗапрос - запрос с необязательным параметром q
//
// Возвращаемое значение:
//  HTTPСервисОтвет - ответ 200 со структурой types
//
Функция НайтиТипы(Запрос) Экспорт
	Шаблон = ВРег(СокрЛП(Строка(Запрос.ПараметрыЗапроса.Получить("q"))));
	Совпадения = Новый Массив;
	Для Каждого Тип Из СчетаМагазинаМетаданные.РеестрТипов() Цикл
		Если Шаблон = ""
			Или СтрНайти(ВРег(Тип.name), Шаблон) > 0
			Или СтрНайти(ВРег(Тип.title), Шаблон) > 0 Тогда
			Совпадения.Добавить(Тип);
		КонецЕсли;
	КонецЦикла;
	Возврат ОтветJSON(200, Новый Структура("types", СортироватьПоИмени(Совпадения)));
КонецФункции

// Возвращает JSON-схему типа.
//
// Параметры:
//  Запрос - HTTPСервисЗапрос - запрос с параметром name
//
// Возвращаемое значение:
//  HTTPСервисОтвет - ответ 200 со схемой либо 400 с ошибкой unknown_type
//
Функция ОписатьТип(Запрос) Экспорт
	ИмяТипа = Строка(Запрос.ПараметрыЗапроса.Получить("name"));
	Данные = СчетаМагазинаМетаданные.ТипПоИмени(ИмяТипа);
	Если Данные = Неопределено Тогда
		Возврат ОтказJSON(400, "unknown_type", "Тип не найден среди поддерживаемых видов Справочник и Документ: " + ИмяТипа);
	КонецЕсли;
	Возврат ОтветJSON(200, СчетаМагазинаМетаданные.Схема(Данные.Мета));
КонецФункции

// Ищет объекты по наименованию или номеру.
//
// Параметры:
//  Запрос - HTTPСервисЗапрос - запрос с параметрами type, q и необязательным limit
//
// Возвращаемое значение:
//  HTTPСервисОтвет - ответ 200 со структурой items и hasMore либо 400/403
//
Функция НайтиОбъекты(Запрос) Экспорт
	ИмяТипа = Строка(Запрос.ПараметрыЗапроса.Получить("type"));
	Данные = СчетаМагазинаМетаданные.ТипПоИмени(ИмяТипа);
	Если Данные = Неопределено Тогда
		Возврат ОтказJSON(400, "unknown_type", "Тип не найден среди поддерживаемых видов Справочник и Документ: " + ИмяТипа);
	КонецЕсли;
	СтрокаПоиска = СокрЛП(Строка(Запрос.ПараметрыЗапроса.Получить("q")));
	Если СтрокаПоиска = "" Тогда
		Возврат ОтказJSON(400, "invalid_request", "Строка поиска пуста");
	КонецЕсли;
	Лимит = 20;
	СтрокаЛимита = Строка(Запрос.ПараметрыЗапроса.Получить("limit"));
	Если СтрокаЛимита <> "" Тогда
		Если Не Цифры(СтрокаЛимита) Тогда
			Возврат ОтказJSON(400, "invalid_request", "limit — целое число от 1 до 100");
		КонецЕсли;
		Лимит = Число(СтрокаЛимита);
		Если Лимит < 1 Или Лимит > 100 Тогда
			Возврат ОтказJSON(400, "invalid_request", "limit — целое число от 1 до 100");
		КонецЕсли;
	КонецЕсли;
	Если Не ПравоДоступа("Чтение", Данные.Мета) Тогда
		Возврат ОтказJSON(403, "forbidden", "Недостаточно прав на операцию");
	КонецЕсли;
	Возврат ОтветJSON(200, СчетаМагазинаДанные.НайтиОбъекты(Данные.Мета, Данные.kind, СтрокаПоиска, Лимит));
КонецФункции

// Читает объект по UUID.
//
// Параметры:
//  Запрос - HTTPСервисЗапрос - запрос с параметрами type и id
//
// Возвращаемое значение:
//  HTTPСервисОтвет - ответ 200 с данными объекта либо 404
//
Функция ПрочитатьОбъект(Запрос) Экспорт
	Данные = СчетаМагазинаМетаданные.ТипПоИмени(Строка(Запрос.ПараметрыЗапроса.Получить("type")));
	Идентификатор = СчетаМагазинаДанные.УникальныйИдентификаторИзСтроки(Запрос.ПараметрыЗапроса.Получить("id"));
	Если Данные = Неопределено Или Идентификатор = Неопределено Тогда
		Возврат ОтказJSON(404, "not_found", "Объект не найден");
	КонецЕсли;
	Результат = СчетаМагазинаДанные.Прочитать(Данные.Мета, Данные.kind, Идентификатор);
	Если Результат = Неопределено Тогда
		Возврат ОтказJSON(404, "not_found", "Объект не найден");
	КонецЕсли;
	Возврат ОтветJSON(200, Результат);
КонецФункции

// Создаёт объект по JSON-телу запроса.
//
// Параметры:
//  Запрос - HTTPСервисЗапрос - запрос с Content-Type application/json и телом объекта
//
// Возвращаемое значение:
//  HTTPСервисОтвет - ответ 201 с краткой информацией либо 400/403/415/422
//
Функция СоздатьОбъект(Запрос) Экспорт
	ТипСодержимого = "";
	Для Каждого Заголовок Из Запрос.Заголовки Цикл
		Если ВРег(Заголовок.Ключ) = "CONTENT-TYPE" Тогда
			ТипСодержимого = Заголовок.Значение;
		КонецЕсли;
	КонецЦикла;
	Если Не СтрНачинаетсяС(ВРег(СокрЛП(ТипСодержимого)), "APPLICATION/JSON") Тогда
		Возврат ОтказJSON(415, "unsupported_media_type", "Требуется Content-Type application/json");
	КонецЕсли;
	Тело = РазобратьТело(Запрос.ПолучитьТелоКакСтроку("UTF-8"));
	Если Тело = Неопределено Тогда
		Возврат ОтказJSON(400, "invalid_request", "Тело должно быть корректным JSON-объектом без данных после значения");
	КонецЕсли;
	ИмяТипаСтрокой = Строка(Тело.Получить("type"));
	ТипДанных = СчетаМагазинаМетаданные.ТипПоИмени(ИмяТипаСтрокой);
	Если ТипДанных = Неопределено Тогда
		Возврат ОтказJSON(400, "unknown_type", "Тип не найден среди поддерживаемых видов Справочник и Документ: " + ИмяТипаСтрокой);
	КонецЕсли;
	Если Не СчетаМагазинаМетаданные.ДопустимКСозданию(ТипДанных.Мета) Тогда
		Возврат ОтказJSON(403, "creation_not_allowed", "Вид не разрешен к созданию правилом сервиса");
	КонецЕсли;
	Если Не ПравоДоступа("Добавление", ТипДанных.Мета) Тогда
		Возврат ОтказJSON(403, "forbidden", "Недостаточно прав на операцию");
	КонецЕсли;
	Ошибки = Новый Массив;
	Подготовлено = СчетаМагазинаДанные.Подготовить(Тело, ТипДанных.Мета, Ошибки);
	Если Ошибки.Количество() > 0 Тогда
		Возврат ОшибкаJSON(400, "invalid_request", "Тело не соответствует описанию типа", Ошибки);
	КонецЕсли;
	Схема = СчетаМагазинаМетаданные.Схема(ТипДанных.Мета);
	ОшибкиСумм = Новый Массив;
	СчетаМагазинаДанные.ПроверитьСуммы(Подготовлено, Схема, ОшибкиСумм);
	Если ОшибкиСумм.Количество() > 0 Тогда
		Возврат ОшибкаJSON(422, "invalid_amounts", "Суммы в строках не сходятся с количеством и ценой", ОшибкиСумм);
	КонецЕсли;
	Попытка
		Запись = СчетаМагазинаДанные.СоздатьОбъект(ТипДанных.Мета, ТипДанных.kind, Подготовлено);
	Исключение
		Возврат НепредвиденнаяОшибка(ИнформацияОбОшибке());
	КонецПопытки;
	Если Не Запись.Создано Тогда
		Возврат ОшибкаJSON(422, "validation_failed", "Объект не прошел проверку заполнения",
			ОшибкиЗаполнения(Запись.Сообщения, Схема, Запись.Объект));
	КонецЕсли;
	Возврат ОтветJSON(201, Запись.Кратко);
КонецФункции

// Обрабатывает переоценку товаров на процент с даты.
//
// Параметры:
//  Запрос - HTTPСервисЗапрос - POST application/json
//
// Возвращаемое значение:
//  HTTPСервисОтвет - ответ 200, 400, 415 или 500
//
Функция ПереоценитьТовары(Запрос) Экспорт
	
	ТипСодержимого = "";
	Для Каждого Заголовок Из Запрос.Заголовки Цикл
		Если ВРег(Заголовок.Ключ) = "CONTENT-TYPE" Тогда
			ТипСодержимого = Заголовок.Значение;
		КонецЕсли;
	КонецЦикла;
	Если Не СтрНачинаетсяС(ВРег(СокрЛП(ТипСодержимого)), "APPLICATION/JSON") Тогда
		Возврат ОтказJSON(415, "unsupported_media_type", "Требуется Content-Type application/json");
	КонецЕсли;
	ТелоТекст = Запрос.ПолучитьТелоКакСтроку("UTF-8");
	Тело = РазобратьТело(ТелоТекст);
	Если Тело = Неопределено Тогда
		Возврат ОтказJSON(400, "invalid_data", "Тело должно быть корректным JSON-объектом");
	КонецЕсли;
	Ошибки = Новый Массив;
	Товары = ПодготовитьТовары(Тело, Ошибки);
	Процент = ПодготовитьПроцент(Тело, ТелоТекст, Ошибки);
	ДатаПереоценки = ПодготовитьДату(Тело, Ошибки);
	Если Ошибки.Количество() > 0 Тогда
		Возврат ОшибкаJSON(400, "invalid_data", "Ошибка входных данных", Ошибки);
	КонецЕсли;
	Попытка
		Результат = СчетаМагазинаДанные.ПереоценитьТовары(Товары, Процент, ДатаПереоценки);
	Исключение
		Возврат НепредвиденнаяОшибка(ИнформацияОбОшибке());
	КонецПопытки;
	Возврат ОтветJSON(200, Результат);
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Сортирует записи по имени.
//
// Параметры:
//  Записи - Массив из Структура - записи с полем name
//
// Возвращаемое значение:
//  Массив из Структура - записи, упорядоченные по name
//
Функция СортироватьПоИмени(Записи)
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("name");
	Таблица.Колонки.Добавить("Запись");
	Для Каждого Запись Из Записи Цикл
		СтрокаТаблицы = Таблица.Добавить();
		СтрокаТаблицы.name = Запись.name;
		СтрокаТаблицы.Запись = Запись;
	КонецЦикла;
	Таблица.Сортировать("name Возр");
	Результат = Новый Массив;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Результат.Добавить(СтрокаТаблицы.Запись);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция РазобратьТело(Текст)
	// Полный разбор: одно значение JSON, затем только конец текста.
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Попытка
		Тело = ПрочитатьJSON(Чтение, Истина);
		ЕстьХвост = Чтение.Прочитать();
	Исключение
		Чтение.Закрыть();
		Возврат Неопределено;
	КонецПопытки;
	Чтение.Закрыть();
	Если ЕстьХвост Или ТипЗнч(Тело) <> Тип("Соответствие") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Тело;
КонецФункции

Функция ОшибкиЗаполнения(Сообщения, Схема, Объект)
	Ошибки = Новый Массив;
	Если Сообщения <> Неопределено Тогда
		Для Каждого Сообщение Из Сообщения Цикл
			Путь = ПутьПоля(Сообщение.Поле, Схема, Объект);
			СчетаМагазинаДанные.Ошибка(Ошибки, Путь, Сообщение.Текст);
		КонецЦикла;
	КонецЕсли;
	Если Ошибки.Количество() = 0 Тогда
		СчетаМагазинаДанные.Ошибка(Ошибки, Неопределено, "Штатная проверка заполнения отказала без сообщения");
	КонецЕсли;
	Возврат Ошибки;
КонецФункции

Функция ПутьПоля(ИмяПоля, Схема, Объект)
	// Только точное сопоставление метаданным, без угадывания поля по тексту сообщения.
	Если СчетаМагазинаДанные.НайтиОписание(Схема.fields, ИмяПоля) <> Неопределено Тогда
		Возврат "header." + ИмяПоля;
	КонецЕсли;
	Для Каждого Таблица Из Схема.tables Цикл
		Для Индекс = 0 По Объект[Таблица.name].Количество() - 1 Цикл
			Для Каждого Поле Из Таблица.fields Цикл
				Путь = Таблица.name + "[" + Формат(Индекс, "ЧГ=0") + "]." + Поле.name;
				Если ИмяПоля = Путь Тогда
					Возврат "tables." + Путь;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция Цифры(Значение)
	Если ПустаяСтрока(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Индекс = 1 По СтрДлина(Значение) Цикл
		Если СтрНайти("0123456789", Сред(Значение, Индекс, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Функция ПодготовитьТовары(Тело, Ошибки)
	
	Результат = Новый Массив;
	Значение = Тело.Получить("items");
	Если ТипЗнч(Значение) <> Тип("Массив") Тогда
		СчетаМагазинаДанные.Ошибка(Ошибки, "items",
			"items должен быть непустым массивом идентификаторов");
		Возврат Результат;
	КонецЕсли;
	Если Значение.Количество() = 0 Тогда
		СчетаМагазинаДанные.Ошибка(Ошибки, "items",
			"items должен быть непустым массивом идентификаторов");
		Возврат Результат;
	КонецЕсли;
	Виденные = Новый Соответствие;
	Ссылки = Новый Массив;
	Индексы = Новый Массив;
	Индекс = 0;
	Для Каждого Ид Из Значение Цикл
		Путь = "items[" + Формат(Индекс, "ЧГ=0") + "]";
		Если ТипЗнч(Ид) <> Тип("Строка") Тогда
			СчетаМагазинаДанные.Ошибка(Ошибки, Путь, "Некорректный идентификатор товара");
		Иначе
			Идентификатор = СчетаМагазинаДанные.УникальныйИдентификаторИзСтроки(Ид);
			Если Идентификатор = Неопределено Тогда
				СчетаМагазинаДанные.Ошибка(Ошибки, Путь, "Некорректный идентификатор товара");
			Иначе
				Ссылка = Справочники._ДемоНоменклатура.ПолучитьСсылку(Идентификатор);
				Если Виденные.Получить(Ссылка) <> Неопределено Тогда
					СчетаМагазинаДанные.Ошибка(Ошибки, Путь, "Товар указан повторно");
				Иначе
					Виденные.Вставить(Ссылка, Истина);
					Ссылки.Добавить(Ссылка);
					Индексы.Добавить(Индекс);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Индекс = Индекс + 1;
	КонецЦикла;
	Если Ссылки.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Ссылка
		|ИЗ
		|	Справочник._ДемоНоменклатура
		|ГДЕ
		|	Ссылка В (&Ссылки)
		|	И НЕ ПометкаУдаления";
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	Найденные = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Найденные.Вставить(Выборка.Ссылка, Истина);
	КонецЦикла;
	Для Индекс = 0 По Ссылки.Количество() - 1 Цикл
		Ссылка = Ссылки[Индекс];
		Если Найденные.Получить(Ссылка) = Неопределено Тогда
			СчетаМагазинаДанные.Ошибка(Ошибки,
				"items[" + Формат(Индексы[Индекс], "ЧГ=0") + "]",
				"Товар не найден или помечен на удаление");
			Продолжить;
		КонецЕсли;
		Результат.Добавить(Новый Структура("Ссылка,Ид",
			Ссылка, Строка(Ссылка.УникальныйИдентификатор())));
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

Функция ПодготовитьПроцент(Тело, ТелоТекст, Ошибки)
	
	Значение = Тело.Получить("percent");
	Если ТипЗнч(Значение) <> Тип("Число") Тогда
		СчетаМагазинаДанные.Ошибка(Ошибки, "percent",
			"Процент должен быть числом от -50 до 100, кроме 0");
		Возврат 0;
	КонецЕсли;
	Если Значение = 0 Или Значение < -50 Или Значение > 100 Тогда
		Токен = ТокенЧислаJSON(ТелоТекст, "percent");
		Если ПустаяСтрока(Токен) Тогда
			Токен = Строка(Значение);
		КонецЕсли;
		СчетаМагазинаДанные.Ошибка(Ошибки, "percent",
			"Процент " + Токен + " недопустим: допустимо от -50 до 100, кроме 0");
	КонецЕсли;
	Возврат Значение;
	
КонецФункции

Функция ПодготовитьДату(Тело, Ошибки)
	
	Значение = Тело.Получить("date");
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		СчетаМагазинаДанные.Ошибка(Ошибки, "date", "Дата должна быть строкой ГГГГ-ММ-ДД");
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Результат = ПрочитатьДатуJSON(Значение, ФорматДатыJSON.ISO);
	Исключение
		Результат = Неопределено;
	КонецПопытки;
	Если Результат = Неопределено
		Или Формат(Результат, "ДФ=yyyy-MM-dd") <> Значение Тогда
		СчетаМагазинаДанные.Ошибка(Ошибки, "date", "Дата должна быть строкой ГГГГ-ММ-ДД");
		Возврат Неопределено;
	КонецЕсли;
	Возврат НачалоДня(Результат);
	
КонецФункции

Функция ТокенЧислаJSON(Текст, ИмяПоля)
	
	Позиция = СтрНайти(Текст, """" + ИмяПоля + """");
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	Позиция = СтрНайти(Текст, ":", НаправлениеПоиска.СНачала, Позиция + СтрДлина(ИмяПоля) + 2);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	Позиция = Позиция + 1;
	Токен = "";
	Пока Позиция <= СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если Символ = " " Или Символ = Символ(9)
			Или Символ = Символ(10) Или Символ = Символ(13) Тогда
			Если Токен = "" Тогда
				Позиция = Позиция + 1;
				Продолжить;
			Иначе
				Прервать;
			КонецЕсли;
		КонецЕсли;
		Если СтрНайти("-+0123456789.eE", Символ) = 0 Тогда
			Прервать;
		КонецЕсли;
		Токен = Токен + Символ;
		Позиция = Позиция + 1;
	КонецЦикла;
	Возврат Токен;
	
КонецФункции

Функция ОтветJSON(Статус, Данные)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	ТекстJSON = Запись.Закрыть();
	Ответ = Новый HTTPСервисОтвет(Статус);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(ТекстJSON, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	Возврат Ответ;
КонецФункции

Функция ОшибкаJSON(Статус, Код, Текст, Подробности)
	Возврат ОтветJSON(Статус, Новый Структура("error", Новый Структура("code,message,details", Код, Текст, Подробности)));
КонецФункции

Функция ОтказJSON(Статус, Код, Текст, Путь = Неопределено)
	Подробности = Новый Массив;
	СчетаМагазинаДанные.Ошибка(Подробности, Путь, Текст);
	Возврат ОшибкаJSON(Статус, Код, Текст, Подробности);
КонецФункции

Функция ЭтоНарушениеПрав(Информация)
	Возврат Информация.ЯвляетсяОшибкойКатегории(КатегорияОшибки.НарушениеПравДоступа, Ложь);
КонецФункции

Функция НепредвиденнаяОшибка(Информация)
	Если ЭтоНарушениеПрав(Информация) Тогда
		Возврат ОтказJSON(403, "forbidden", "Недостаточно прав на операцию");
	КонецЕсли;
	ЗаписьЖурналаРегистрации("СчетаМагазина", УровеньЖурналаРегистрации.Ошибка,,,
		ПодробноеПредставлениеОшибки(Информация));
	Возврат ОтказJSON(500, "internal_error", КраткоеПредставлениеОшибки(Информация));
КонецФункции

#КонецОбласти
