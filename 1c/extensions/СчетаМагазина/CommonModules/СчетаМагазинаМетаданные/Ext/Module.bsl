Функция Схема(Мета) Экспорт
	Если Метаданные.Справочники.Найти(Мета.Имя) = Мета Тогда
		Вид = "catalog";
	Иначе
		Вид = "document";
	КонецЕсли;
	Поля = Новый Массив;
	Для Каждого Реквизит Из Мета.СтандартныеРеквизиты Цикл
		Поля.Добавить(СтандартноеПоле(Реквизит, Вид, Мета));
	КонецЦикла;
	Для Каждого Реквизит Из Мета.Реквизиты Цикл
		Поля.Добавить(ОписаниеПоля(Реквизит, Истина));
	КонецЦикла;
	Таблицы = Новый Массив;
	Для Каждого Таблица Из Мета.ТабличныеЧасти Цикл
		Таблицы.Добавить(ОписаниеТаблицы(Таблица));
	КонецЦикла;
	Возврат Новый Структура("type,kind,title,creatable,fields,tables,rules",
		ИмяТипа(Мета), Вид, Мета.Представление(), ДопустимКСозданию(Мета),
		Поля, Таблицы, ПравилаСервиса());
КонецФункции

Функция СтандартноеПоле(Реквизит, Вид, Мета)
	Записываемо = Ложь;
	Причина = "";
	Имя = Реквизит.Имя;
	Если Вид = "catalog" Тогда
		Если Имя = "Наименование" Тогда
			Записываемо = Реквизит.Тип.КвалификаторыСтроки.Длина > 0;
		ИначеЕсли Имя = "Владелец" Тогда
			Записываемо = Истина;
		ИначеЕсли Имя = "Код" Тогда
			// Спецификация: при отключенной автонумерации Код записываем,
			// платформа сама код не генерирует.
			Записываемо = Не Мета.Автонумерация И ДлинаКвалификатораКода(Реквизит) > 0;
			Если Не Записываемо Тогда
				Причина = "Стандартное техническое поле назначает 1С";
			КонецЕсли;
		ИначеЕсли Имя = "Родитель" Тогда
			Причина = "Группы не поддерживаются";
		КонецЕсли;
	Иначе
		Если Имя = "Дата" Тогда
			Записываемо = Истина;
		КонецЕсли;
	КонецЕсли;
	Поле = ОписаниеПоля(Реквизит, Записываемо, Истина);
	Если Причина <> "" Тогда
		Поле.Вставить("reason", Причина);
	КонецЕсли;
	Если Вид = "document" И Имя = "Дата" Тогда
		Поле.required = Истина;
	КонецЕсли;
	Возврат Поле;
КонецФункции

Функция ДлинаКвалификатораКода(Реквизит)
	Для Каждого ТипКода Из Реквизит.Тип.Типы() Цикл
		Если ТипКода = Тип("Строка") Тогда
			Возврат Реквизит.Тип.КвалификаторыСтроки.Длина;
		ИначеЕсли ТипКода = Тип("Число") Тогда
			Возврат Реквизит.Тип.КвалификаторыЧисла.Разрядность;
		КонецЕсли;
	КонецЦикла;
	Возврат 0;
КонецФункции

Функция ОписаниеТаблицы(Таблица)
	Доступна = Не ОбслуживаемаяБСПТаблица(Таблица.Имя);
	Описание = Новый Структура("name,title,writable,required,fields", Таблица.Имя,
		Таблица.Представление(), Доступна,
		Таблица.ПроверкаЗаполнения = ПроверкаЗаполнения.ВыдаватьОшибку, Новый Массив);
	Если Не Доступна Тогда
		Описание.Вставить("reason", "Табличная часть обслуживается механизмами БСП");
	КонецЕсли;
	Для Каждого Реквизит Из Таблица.СтандартныеРеквизиты Цикл
		Описание.fields.Добавить(ОписаниеПоля(Реквизит, Ложь, Истина));
	КонецЦикла;
	Для Каждого Реквизит Из Таблица.Реквизиты Цикл
		Описание.fields.Добавить(ОписаниеПоля(Реквизит, Доступна));
	КонецЦикла;
	Возврат Описание;
КонецФункции

Функция ОбслуживаемаяБСПТаблица(ИмяТаблицы) Экспорт
	Возврат ИмяТаблицы = "ДополнительныеРеквизиты" Или ИмяТаблицы = "КонтактнаяИнформация";
КонецФункции

Функция ПравилаСервиса()
	Правила = Новый Структура;
	Правила.Вставить("validation", "Окончательное решение принимает штатная проверка заполнения 1С; условные правила зависят от данных и настроек базы");
	Правила.Вставить("dates", "ISO 8601 без часового пояса; местное время базы");
	Правила.Вставить("null", "Штатное пустое значение; обязательность проверяет 1С");
	Правила.Вставить("posting", "Документ создается непроведенным");
	Правила.Вставить("amounts", "Суммы и значения по умолчанию сервис не рассчитывает; сумма строки должна равняться округленному произведению количества на цену");
	Возврат Правила;
КонецФункции

Функция ОписаниеПоля(Реквизит, ДоступенДляЗаписи, Стандартный = Ложь) Экспорт
	Обязательно = Ложь;
	Если Не Стандартный Тогда
		Обязательно = Реквизит.ПроверкаЗаполнения = ПроверкаЗаполнения.ВыдаватьОшибку;
	КонецЕсли;
	Поле = Новый Структура("name,title,writable,required,types", Реквизит.Имя,
		Реквизит.Представление(), ДоступенДляЗаписи, Обязательно, Новый Массив);
	Для Каждого ТипПоля Из Реквизит.Тип.Типы() Цикл
		Описание = ОписаниеТипа(ТипПоля, Реквизит.Тип);
		Поле.types.Добавить(Описание);
		Если Описание.kind = "unsupported" Тогда
			Поле.writable = Ложь;
			Поле.Вставить("reason", "Тип поля не поддерживается этой версией: " + Описание.name);
		КонецЕсли;
	КонецЦикла;
	Если Не Поле.writable И Не Поле.Свойство("reason") Тогда
		Поле.Вставить("reason", "Поле недоступно для записи через этот сервис");
	КонецЕсли;
	Возврат Поле;
КонецФункции

Функция ОписаниеТипа(ТипПоля, ОписаниеТиповПоля) Экспорт
	Описание = Новый Структура("name,kind", Строка(ТипПоля), "unsupported");
	Если ТипПоля = Тип("Строка") Тогда
		Описание.name = "string";
		Описание.kind = "string";
		Описание.Вставить("length", ОписаниеТиповПоля.КвалификаторыСтроки.Длина);
		Описание.Вставить("fixedLength", ОписаниеТиповПоля.КвалификаторыСтроки.ДопустимаяДлина = ДопустимаяДлина.Фиксированная);
	ИначеЕсли ТипПоля = Тип("Число") Тогда
		Описание.name = "number";
		Описание.kind = "number";
		Квалификатор = ОписаниеТиповПоля.КвалификаторыЧисла;
		Описание.Вставить("digits", Квалификатор.Разрядность);
		Описание.Вставить("fractionDigits", Квалификатор.РазрядностьДробнойЧасти);
		Описание.Вставить("nonnegative", Квалификатор.ДопустимыйЗнак = ДопустимыйЗнак.Неотрицательный);
	ИначеЕсли ТипПоля = Тип("Булево") Тогда
		Описание.name = "boolean";
		Описание.kind = "boolean";
	ИначеЕсли ТипПоля = Тип("Дата") Тогда
		Описание.name = "date";
		Описание.kind = "date";
		Часть = ОписаниеТиповПоля.КвалификаторыДаты.ЧастиДаты;
		Описание.Вставить("parts", ?(Часть = ЧастиДаты.Дата, "date", "dateTime"));
		Если Часть = ЧастиДаты.Время Тогда
			Описание.kind = "unsupported";
		КонецЕсли;
	Иначе
		МетаТипа = Метаданные.НайтиПоТипу(ТипПоля);
		Если МетаТипа <> Неопределено Тогда
			Если Метаданные.Справочники.Найти(МетаТипа.Имя) = МетаТипа Тогда
				Описание.name = "CatalogRef." + МетаТипа.Имя;
				Описание.kind = "catalog";
				Описание.Вставить("catalog", МетаТипа.Имя);
				Описание.Вставить("searchUrl", "/search?type=Справочник." + МетаТипа.Имя);
			ИначеЕсли Метаданные.Документы.Найти(МетаТипа.Имя) = МетаТипа Тогда
				Описание.name = "DocumentRef." + МетаТипа.Имя;
				Описание.kind = "document";
				Описание.Вставить("document", МетаТипа.Имя);
				Описание.Вставить("searchUrl", "/search?type=Документ." + МетаТипа.Имя);
			ИначеЕсли Метаданные.Перечисления.Найти(МетаТипа.Имя) = МетаТипа Тогда
				Описание.name = "EnumRef." + МетаТипа.Имя;
				Описание.kind = "enum";
				Описание.Вставить("enumeration", МетаТипа.Имя);
				Описание.Вставить("values", Новый Массив);
				Для Каждого ЗначениеМета Из МетаТипа.ЗначенияПеречисления Цикл
					Описание.values.Добавить(Новый Структура("name,title", ЗначениеМета.Имя, ЗначениеМета.Представление()));
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Возврат Описание;
КонецФункции

Функция ИмяТипа(Мета) Экспорт
	Если Метаданные.Справочники.Найти(Мета.Имя) = Мета Тогда
		Возврат "Справочник." + Мета.Имя;
	КонецЕсли;
	Возврат "Документ." + Мета.Имя;
КонецФункции

Функция ТипПоИмени(ИмяТипа) Экспорт
	Части = СтрРазделить(ИмяТипа, ".");
	Если Части.Количество() <> 2 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Части[0] = "Справочник" Тогда
		Мета = Метаданные.Справочники.Найти(Части[1]);
		Вид = "catalog";
	ИначеЕсли Части[0] = "Документ" Тогда
		Мета = Метаданные.Документы.Найти(Части[1]);
		Вид = "document";
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	Если Мета = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура("Мета,kind", Мета, Вид);
КонецФункции

Функция РеестрТипов() Экспорт
	Результат = Новый Массив;
	Для Каждого Мета Из Метаданные.Справочники Цикл
		Результат.Добавить(ЗаписьРеестра(Мета, "catalog"));
	КонецЦикла;
	Для Каждого Мета Из Метаданные.Документы Цикл
		Результат.Добавить(ЗаписьРеестра(Мета, "document"));
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ДопустимКСозданию(Мета) Экспорт
	Если Не (СтрНачинаетсяС(Мета.Имя, "_Демо") Или Мета.Имя = "Валюты") Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Метаданные.Справочники.Найти(Мета.Имя) <> Мета Тогда
		Возврат Истина;
	КонецЕсли;
	// Справочник с составным владельцем или владельцем-документом не создаем.
	Если Мета.Владельцы.Количество() > 1 Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого Владелец Из Мета.Владельцы Цикл
		Если Метаданные.Документы.Найти(Владелец.Имя) = Владелец Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Функция ЗаписьРеестра(Мета, Вид)
	Возврат Новый Структура("name,kind,title,creatable",
		ИмяТипа(Мета), Вид, Мета.Представление(), ДопустимКСозданию(Мета));
КонецФункции
