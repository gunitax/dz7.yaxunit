Функция Подготовить(Данные, Мета, Ошибки) Экспорт
	Результат = Новый Структура("header,tables", Новый Соответствие, Новый Соответствие);
	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		Ошибка(Ошибки, Неопределено, "Тело должно быть объектом с header и tables");
		Возврат Результат;
	КонецЕсли;
	Для Каждого Элемент Из Данные Цикл
		Если Элемент.Ключ <> "type"
			И Элемент.Ключ <> "header"
			И Элемент.Ключ <> "tables" Тогда
			Ошибка(Ошибки, Элемент.Ключ, "Неизвестное поле");
		КонецЕсли;
	КонецЦикла;
	Схема = СчетаМагазинаМетаданные.Схема(Мета);
	Если ТипЗнч(Данные.Получить("header")) <> Тип("Соответствие") Тогда
		Ошибка(Ошибки, "header", "Требуется объект header");
	Иначе
		ПодготовитьПоля(Данные.Получить("header"), Схема.fields, Мета, "header", Результат.header, Ошибки);
	КонецЕсли;
	Таблицы = Данные.Получить("tables");
	Если ТипЗнч(Таблицы) <> Тип("Соответствие") Тогда
		Ошибка(Ошибки, "tables", "Требуется объект tables");
		Возврат Результат;
	КонецЕсли;
	Для Каждого Элемент Из Таблицы Цикл
		Путь = "tables." + Элемент.Ключ;
		Описание = НайтиОписание(Схема.tables, Элемент.Ключ);
		Если Описание = Неопределено Тогда
			Ошибка(Ошибки, Путь, "Неизвестная табличная часть");
			Продолжить;
		КонецЕсли;
		Если Не Описание.writable Тогда
			Ошибка(Ошибки, Путь, Описание.reason);
			Продолжить;
		КонецЕсли;
		Если ТипЗнч(Элемент.Значение) <> Тип("Массив") Тогда
			Ошибка(Ошибки, Путь, "Требуется массив строк");
			Продолжить;
		КонецЕсли;
		Строки = Новый Массив;
		Индекс = 0;
		Для Каждого СтрокаДанных Из Элемент.Значение Цикл
			ПутьСтроки = Путь + "[" + Формат(Индекс, "ЧГ=0") + "]";
			СтрокаТипизированная = Новый Соответствие;
			Если ТипЗнч(СтрокаДанных) <> Тип("Соответствие") Тогда
				Ошибка(Ошибки, ПутьСтроки, "Требуется объект строки");
			Иначе
				ПодготовитьПоля(СтрокаДанных, Описание.fields, Мета.ТабличныеЧасти[Элемент.Ключ],
					ПутьСтроки, СтрокаТипизированная, Ошибки);
			КонецЕсли;
			Строки.Добавить(СтрокаТипизированная);
			Индекс = Индекс + 1;
		КонецЦикла;
		Результат.tables.Вставить(Элемент.Ключ, Строки);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Процедура ПодготовитьПоля(Вход, Поля, Мета, Префикс, Выход, Ошибки)
	Для Каждого Элемент Из Вход Цикл
		Путь = Префикс + "." + Элемент.Ключ;
		Поле = НайтиОписание(Поля, Элемент.Ключ);
		Если Поле = Неопределено Тогда
			Ошибка(Ошибки, Путь, "Неизвестное поле");
			Продолжить;
		КонецЕсли;
		Если Не Поле.writable Тогда
			Ошибка(Ошибки, Путь, Поле.reason);
			Продолжить;
		КонецЕсли;
		МетаПоля = Реквизит(Мета, Элемент.Ключ);
		ОшибокДо = Ошибки.Количество();
		Значение = Преобразовать(Элемент.Значение, Поле, МетаПоля.Тип, Путь, Ошибки);
		Если ОшибокДо = Ошибки.Количество() Тогда
			Выход.Вставить(Элемент.Ключ, Значение);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция Преобразовать(Вход, Поле, ТипыПоля, Путь, Ошибки)
	Если Вход = Неопределено Тогда
		Возврат ТипыПоля.ПривестиЗначение(Неопределено);
	КонецЕсли;
	Типы = ТипыПоля.Типы();
	ИндексТипа = 0;
	Если Поле.types.Количество() > 1 Тогда
		Если ТипЗнч(Вход) <> Тип("Соответствие") Тогда
			Ошибка(Ошибки, Путь, "Составной тип требует объект type и value");
			Возврат Неопределено;
		КонецЕсли;
		ЕстьЗначение = Ложь;
		Для Каждого Ключ Из Вход Цикл
			Если Ключ.Ключ = "value" Тогда
				ЕстьЗначение = Истина;
			ИначеЕсли Ключ.Ключ <> "type" Тогда
				Ошибка(Ошибки, Путь, "Неизвестное поле типизированного значения");
			КонецЕсли;
		КонецЦикла;
		ИндексТипа = -1;
		Для Индекс = 0 По Поле.types.Количество() - 1 Цикл
			Если Поле.types[Индекс].name = Вход.Получить("type") Тогда
				ИндексТипа = Индекс;
			КонецЕсли;
		КонецЦикла;
		Если ИндексТипа = -1 Или Не ЕстьЗначение Тогда
			Ошибка(Ошибки, Путь, "Недопустимый type либо отсутствует value");
			Возврат Неопределено;
		КонецЕсли;
		Вход = Вход.Получить("value");
	КонецЕсли;
	Описание = Поле.types[ИндексТипа];
	Если Вход = Неопределено Тогда
		ОдинТип = Новый Массив;
		ОдинТип.Добавить(Типы[ИндексТипа]);
		ОписаниеОдногоТипа = Новый ОписаниеТипов(ОдинТип);
		Возврат ОписаниеОдногоТипа.ПривестиЗначение(Неопределено);
	КонецЕсли;
	Корректно = Ложь;
	Результат = Неопределено;
	Если Описание.kind = "string" Тогда
		Корректно = ТипЗнч(Вход) = Тип("Строка");
		Если Корректно Тогда
			Корректно = Описание.length = 0 Или СтрДлина(Вход) <= Описание.length;
			Если Описание.fixedLength И Описание.length > 0 Тогда
				Корректно = СтрДлина(Вход) = Описание.length;
			КонецЕсли;
		КонецЕсли;
		Результат = Вход;
	ИначеЕсли Описание.kind = "number" Тогда
		Корректно = ТипЗнч(Вход) = Тип("Число");
		Если Корректно Тогда
			Корректно = Окр(Вход, Описание.fractionDigits) = Вход
				И ?(Вход < 0, -Вход, Вход) < Pow(10, Описание.digits - Описание.fractionDigits)
				И (Не Описание.nonnegative Или Вход >= 0);
		КонецЕсли;
		Результат = Вход;
	ИначеЕсли Описание.kind = "boolean" Тогда
		Корректно = ТипЗнч(Вход) = Тип("Булево");
		Результат = Вход;
	ИначеЕсли Описание.kind = "date" Тогда
		Если ТипЗнч(Вход) = Тип("Строка") Тогда
			Попытка
				Результат = ПрочитатьДатуJSON(Вход, ФорматДатыJSON.ISO);
				Корректно = Вход = ДатаСтрокой(Результат, Описание.parts = "date");
			Исключение
				Корректно = Ложь;
			КонецПопытки;
		КонецЕсли;
	ИначеЕсли Описание.kind = "catalog" Тогда
		Идентификатор = УникальныйИдентификаторИзСтроки(Вход);
		Если Идентификатор <> Неопределено Тогда
			Результат = Справочники[Описание.catalog].ПолучитьСсылку(Идентификатор);
			Корректно = СсылкаДоступна(Метаданные.Справочники[Описание.catalog], Результат);
		КонецЕсли;
	ИначеЕсли Описание.kind = "document" Тогда
		Идентификатор = УникальныйИдентификаторИзСтроки(Вход);
		Если Идентификатор <> Неопределено Тогда
			Результат = Документы[Описание.document].ПолучитьСсылку(Идентификатор);
			Корректно = СсылкаДоступна(Метаданные.Документы[Описание.document], Результат);
		КонецЕсли;
	ИначеЕсли Описание.kind = "enum" Тогда
		Если ТипЗнч(Вход) = Тип("Строка") Тогда
			Для Каждого ЗначениеМета Из Описание.values Цикл
				Если Вход = ЗначениеМета.name Тогда
					Результат = Перечисления[Описание.enumeration][Вход];
					Корректно = Истина;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	Если Не Корректно Тогда
		Ошибка(Ошибки, Путь, "Недопустимое значение, тип, ограничение или ссылка; ожидается " + Описание.name);
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция СсылкаДоступна(Мета, Ссылка) Экспорт
	// Мета получена вызывающим из описания типа, а не из пользовательской строки.
	Если Не ПравоДоступа("Чтение", Мета) Тогда
		Возврат Ложь;
	КонецЕсли;
	ЭтоСправочник = Метаданные.Справочники.Найти(Мета.Имя) = Мета;
	Таблица = ?(ЭтоСправочник, "Справочник.", "Документ.") + Мета.Имя;
	Условия = " ГДЕ Ссылка = &Ссылка И НЕ ПометкаУдаления";
	Если ЭтоСправочник Тогда
		Условия = Условия + УсловиеЭлементов(Мета);
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ Ссылка ИЗ " + Таблица + Условия;
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Попытка
		Возврат Не Запрос.Выполнить().Пустой();
	Исключение
		Если ИнформацияОбОшибке().ЯвляетсяОшибкойКатегории(КатегорияОшибки.НарушениеПравДоступа, Ложь) Тогда
			Возврат Ложь;
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
КонецФункции

Функция НайтиОбъекты(Мета, Вид, СтрокаПоиска, Лимит) Экспорт
	// Вызывающий обработчик проверяет доступ и параметры.
	ПолеПоиска = ?(Вид = "document", "Номер", "Наименование");
	Таблица = ?(Вид = "document", "Документ.", "Справочник.") + Мета.Имя;
	Условия = " ГДЕ НЕ ПометкаУдаления";
	Если Вид <> "document" Тогда
		Условия = Условия + УсловиеЭлементов(Мета);
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ " + Формат(Лимит + 1, "ЧГ=0")
		+ " Ссылка, " + ПолеПоиска + " ИЗ " + Таблица + Условия
		+ " И " + ПолеПоиска + " ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""~"""
		+ " УПОРЯДОЧИТЬ ПО " + ПолеПоиска + ", Ссылка";
	Запрос.УстановитьПараметр("Шаблон", "%" + ОбщегоНазначения.СформироватьСтрокуДляПоискаВЗапросе(СтрокаПоиска) + "%");
	Выборка = Запрос.Выполнить().Выбрать();
	Элементы = Новый Массив;
	ЕстьЕще = Ложь;
	Пока Выборка.Следующий() Цикл
		Если Элементы.Количество() = Лимит Тогда
			ЕстьЕще = Истина;
			Прервать;
		КонецЕсли;
		Элементы.Добавить(Новый Структура("id,name", Строка(Выборка.Ссылка.УникальныйИдентификатор()), Строка(Выборка[ПолеПоиска])));
	КонецЦикла;
	Возврат Новый Структура("items,hasMore", Элементы, ЕстьЕще);
КонецФункции

Функция УсловиеЭлементов(Мета)
	Если Мета.Иерархический И Мета.ВидИерархии = Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияГруппИЭлементов Тогда
		Возврат " И НЕ ЭтоГруппа";
	КонецЕсли;
	Возврат "";
КонецФункции

Процедура Заполнить(Объект, Данные) Экспорт
	Для Каждого Поле Из Данные.header Цикл
		Объект[Поле.Ключ] = Поле.Значение;
	КонецЦикла;
	Для Каждого Таблица Из Данные.tables Цикл
		Для Каждого СтрокаДанных Из Таблица.Значение Цикл
			СтрокаОбъекта = Объект[Таблица.Ключ].Добавить();
			Для Каждого Поле Из СтрокаДанных Цикл
				СтрокаОбъекта[Поле.Ключ] = Поле.Значение;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

Функция СоздатьОбъект(Мета, Вид, Подготовлено) Экспорт
	// Создание и запись нового объекта: транзакция закрывается на всех путях.
	// Создано = Ложь: штатная проверка заполнения отказала, Сообщения заполнены.
	// Исключение пробрасывается вызывающему, транзакция отменена, объект не записан.
	ЭтоДокумент = Вид = "document";
	Если ЭтоДокумент Тогда
		Объект = Документы[Мета.Имя].СоздатьДокумент();
	Иначе
		Объект = Справочники[Мета.Имя].СоздатьЭлемент();
		Если ПустаяСтрока(Объект.Код) И Мета.Автонумерация Тогда
			Объект.УстановитьНовыйКод();
		КонецЕсли;
	КонецЕсли;
	Результат = Новый Структура("Создано,Кратко,Сообщения,Объект", Ложь, Неопределено, Новый Массив, Объект);
	НачатьТранзакцию();
	Попытка
		Заполнить(Объект, Подготовлено);
		Если ЭтоДокумент И ПустаяСтрока(Объект.Номер) Тогда
			Объект.УстановитьНовыйНомер();
		КонецЕсли;
		Объект.ОбменДанными.Загрузка = Истина;
		Объект.ОбменДанными.Загрузка = Ложь;
		ПроверкаПрошла = Объект.ПроверитьЗаполнение();
		Если Не ПроверкаПрошла Тогда
			Результат.Сообщения = ПолучитьСообщенияПользователю(Истина);
			ОтменитьТранзакцию();
			Возврат Результат;
		КонецЕсли;
		Если ЭтоДокумент Тогда
			Объект.Записать(РежимЗаписиДокумента.Запись);
			Если Объект.Проведен Тогда
				ВызватьИсключение "Документ записан проведенным вопреки режиму записи";
			КонецЕсли;
		Иначе
			Объект.Записать();
		КонецЕсли;
		// Ответ собирается до завершения транзакции.
		Результат.Кратко = Кратко(Объект, Мета, Вид);
		Результат.Создано = Истина;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Результат;
КонецФункции

Функция Прочитать(Мета, Вид, Идентификатор) Экспорт
	Если Не ПравоДоступа("Чтение", Мета) Тогда
		Возврат Неопределено;
	КонецЕсли;
	ЭтоДокумент = Вид = "document";
	Если ЭтоДокумент Тогда
		Ссылка = Документы[Мета.Имя].ПолучитьСсылку(Идентификатор);
	Иначе
		Ссылка = Справочники[Мета.Имя].ПолучитьСсылку(Идентификатор);
	КонецЕсли;
	Условия = " ГДЕ Ссылка = &Ссылка";
	Если Не ЭтоДокумент Тогда
		Условия = Условия + УсловиеЭлементов(Мета);
	КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ Ссылка ИЗ "
		+ ?(ЭтоДокумент, "Документ.", "Справочник.") + Мета.Имя + Условия);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Если Запрос.Выполнить().Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Объект = Ссылка.ПолучитьОбъект();
	Если Объект = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Результат = Кратко(Объект, Мета, Вид);
	Результат.Вставить("header", Новый Соответствие);
	Результат.Вставить("tables", Новый Соответствие);
	Схема = СчетаМагазинаМетаданные.Схема(Мета);
	Для Каждого Поле Из Схема.fields Цикл
		Если Поле.writable Тогда
			Результат.header.Вставить(Поле.name, ЗначениеJSON(Объект[Поле.name], Поле, Реквизит(Мета, Поле.name).Тип));
		КонецЕсли;
	КонецЦикла;
	Для Каждого Таблица Из Схема.tables Цикл
		Если Не Таблица.writable Тогда
			Продолжить;
		КонецЕсли;
		Строки = Новый Массив;
		Для Каждого СтрокаОбъекта Из Объект[Таблица.name] Цикл
			СтрокаJSON = Новый Соответствие;
			Для Каждого Поле Из Таблица.fields Цикл
				Если Поле.writable Тогда
					МетаПоля = Мета.ТабличныеЧасти[Таблица.name].Реквизиты[Поле.name];
					СтрокаJSON.Вставить(Поле.name, ЗначениеJSON(СтрокаОбъекта[Поле.name], Поле, МетаПоля.Тип));
				КонецЕсли;
			КонецЦикла;
			Строки.Добавить(СтрокаJSON);
		КонецЦикла;
		Результат.tables.Вставить(Таблица.name, Строки);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция Кратко(Объект, Мета, Вид) Экспорт
	Идентификатор = Строка(Объект.Ссылка.УникальныйИдентификатор());
	ТипОбъекта = СчетаМагазинаМетаданные.ИмяТипа(Мета);
	Если Вид = "document" Тогда
		Возврат Новый Структура("id,type,kind,number,date,posted",
			Идентификатор, ТипОбъекта, Вид,
			Объект.Номер, ДатаСтрокой(Объект.Дата), Объект.Проведен);
	КонецЕсли;
	Возврат Новый Структура("id,type,kind,code",
		Идентификатор, ТипОбъекта, Вид, Объект.Код);
КонецФункции

Функция ЗначениеJSON(Значение, Поле, Типы)
	Описание = СчетаМагазинаМетаданные.ОписаниеТипа(ТипЗнч(Значение), Типы);
	Если Описание.kind = "catalog" Или Описание.kind = "document" Тогда
		Результат = ?(ЗначениеЗаполнено(Значение), Строка(Значение.УникальныйИдентификатор()), Неопределено);
	ИначеЕсли Описание.kind = "enum" Тогда
		Результат = ?(ЗначениеЗаполнено(Значение), ОбщегоНазначения.ИмяЗначенияПеречисления(Значение), Неопределено);
	ИначеЕсли Описание.kind = "date" Тогда
		Результат = ?(ЗначениеЗаполнено(Значение), ДатаСтрокой(Значение, Описание.parts = "date"), Неопределено);
	Иначе
		Результат = Значение;
	КонецЕсли;
	Если Поле.types.Количество() > 1 И Значение <> Неопределено Тогда
		Возврат Новый Структура("type,value", Описание.name, Результат);
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция ДатаСтрокой(Значение, ТолькоДата = Ложь) Экспорт
	Результат = Формат(Значение, "ДФ=yyyy-MM-dd");
	Если Не ТолькоДата Тогда
		Результат = Результат + "T" + Формат(Значение, "ДФ=HH:mm:ss");
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция УникальныйИдентификаторИзСтроки(Значение) Экспорт
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если СтрДлина(Значение) <> 36 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Результат = Новый УникальныйИдентификатор(Значение);
		Если Значение = Строка(Результат) Тогда
			Возврат Результат;
		КонецЕсли;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Возврат Неопределено;
КонецФункции

Функция НайтиОписание(Описания, Имя) Экспорт
	Для Каждого Описание Из Описания Цикл
		Если Описание.name = Имя Тогда
			Возврат Описание;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция Реквизит(Мета, Имя)
	Для Каждого Стандартный Из Мета.СтандартныеРеквизиты Цикл
		Если Стандартный.Имя = Имя Тогда
			Возврат Стандартный;
		КонецЕсли;
	КонецЦикла;
	Возврат Мета.Реквизиты[Имя];
КонецФункции

Процедура Ошибка(Ошибки, Путь, Текст) Экспорт
	Ошибки.Добавить(Новый Структура("path,message", Путь, Текст));
КонецПроцедуры

// Проверяет количество, цену и сумму одной строки табличной части.
// Количество и цена должны быть больше нуля, сумма должна равняться
// округленному произведению количества на цену.
//
// Параметры:
//  Количество - Число - количество строки; Неопределено трактуется как 0
//  Цена - Число - цена строки; Неопределено трактуется как 0
//  Сумма - Число - сумма строки; Неопределено трактуется как 0
//  ЗнаковСуммы - Число - число знаков дробной части поля Сумма
//
// Возвращаемое значение:
//  Массив из Структура - Поле и Текст нарушений; пустой массив, если нарушений нет
//
Функция ОшибкиСтрокиСумм(Количество, Цена, Сумма, ЗнаковСуммы = 2) Экспорт
	
	Количество = ?(Количество = Неопределено, 0, Количество);
	Цена = ?(Цена = Неопределено, 0, Цена);
	Сумма = ?(Сумма = Неопределено, 0, Сумма);
	
	Ошибки = Новый Массив;
	
	КоличествоЧисло = ТипЗнч(Количество) = Тип("Число");
	КоличествоПоложительно = Ложь;
	Если КоличествоЧисло Тогда
		КоличествоПоложительно = Количество > 0;
	КонецЕсли;
	Если Не КоличествоЧисло Тогда
		Ошибки.Добавить(Новый Структура("Поле,Текст",
			"Количество", "Количество должно быть числом"));
	ИначеЕсли Не КоличествоПоложительно Тогда
		Ошибки.Добавить(Новый Структура("Поле,Текст",
			"Количество", "Количество должно быть больше нуля"));
	КонецЕсли;
	
	ЦенаЧисло = ТипЗнч(Цена) = Тип("Число");
	ЦенаПоложительна = Ложь;
	Если ЦенаЧисло Тогда
		ЦенаПоложительна = Цена > 0;
	КонецЕсли;
	Если Не ЦенаЧисло Тогда
		Ошибки.Добавить(Новый Структура("Поле,Текст",
			"Цена", "Цена должна быть числом"));
	ИначеЕсли Не ЦенаПоложительна Тогда
		Ошибки.Добавить(Новый Структура("Поле,Текст",
			"Цена", "Цена должна быть больше нуля"));
	КонецЕсли;
	
	Если ТипЗнч(Сумма) <> Тип("Число") Тогда
		Ошибки.Добавить(Новый Структура("Поле,Текст",
			"Сумма", "Сумма должна быть числом"));
	ИначеЕсли КоличествоПоложительно И ЦенаПоложительна Тогда
		Ожидаемая = Окр(Количество * Цена, ЗнаковСуммы);
		Если Сумма <> Ожидаемая Тогда
			Ошибки.Добавить(Новый Структура("Поле,Текст", "Сумма",
				"Сумма " + ЧислоСтрокой(Сумма, 15)
				+ " не равна количеству " + ЧислоСтрокой(Количество, 15)
				+ " × цене " + ЧислоСтрокой(Цена, 15)
				+ " = " + ЧислоСтрокой(Ожидаемая, 15)));
		КонецЕсли;
	КонецЕсли;
	
	Возврат Ошибки;
	
КонецФункции

Функция ЧислоСтрокой(Значение, Знаков)
	
	Результат = Формат(Значение, "ЧДЦ=" + Строка(Знаков) + "; ЧГ=0");
	Если Результат = "" Тогда
		Результат = Строка(Значение);
	КонецЕсли;
	Если СтрНайти(Результат, ",") > 0 Тогда
		Пока Прав(Результат, 1) = "0" Цикл
			Результат = Лев(Результат, СтрДлина(Результат) - 1);
		КонецЦикла;
		Если Прав(Результат, 1) = "," Тогда
			Результат = Лев(Результат, СтрДлина(Результат) - 1);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Проверяет строки табличных частей, где есть количество, цена и сумма.
// Пути ошибок формируются в формате tables.<ТабличнаяЧасть>[<индекс>].<Поле>.
//
// Параметры:
//  Подготовлено - Структура - результат Подготовить: поля header и tables
//  Схема - Структура - описание типа, полученное СчетаМагазинаМетаданные.Схема
//  Ошибки - Массив из Структура - дополняется структурами path и message
//
Процедура ПроверитьСуммы(Подготовлено, Схема, Ошибки) Экспорт
	
	Если Схема.kind <> "document" Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Таблица Из Подготовлено.tables Цикл
		Описание = НайтиОписание(Схема.tables, Таблица.Ключ);
		Если Описание = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Не Описание.writable Тогда
			Продолжить;
		КонецЕсли;
		
		ПолеКоличество = НайтиОписание(Описание.fields, "Количество");
		ПолеЦена = НайтиОписание(Описание.fields, "Цена");
		ПолеСумма = НайтиОписание(Описание.fields, "Сумма");
		Если ПолеКоличество = Неопределено Или ПолеЦена = Неопределено Или ПолеСумма = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Не ПолеКоличество.writable Или Не ПолеЦена.writable Или Не ПолеСумма.writable Тогда
			Продолжить;
		КонецЕсли;
		
		Если ОписаниеЧисловогоТипа(ПолеКоличество) = Неопределено
			Или ОписаниеЧисловогоТипа(ПолеЦена) = Неопределено
			Или ОписаниеЧисловогоТипа(ПолеСумма) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ЧислоСумма = ОписаниеЧисловогоТипа(ПолеСумма);
		
		Индекс = 0;
		Для Каждого СтрокаДанных Из Таблица.Значение Цикл
			ОшибкиСтроки = ОшибкиСтрокиСумм(
				СтрокаДанных.Получить("Количество"),
				СтрокаДанных.Получить("Цена"),
				СтрокаДанных.Получить("Сумма"),
				ЧислоСумма.fractionDigits);
			Для Каждого ОшибкаСтроки Из ОшибкиСтроки Цикл
				Ошибка(Ошибки,
					"tables." + Описание.name + "[" + Строка(Индекс) + "]." + ОшибкаСтроки.Поле,
					ОшибкаСтроки.Текст);
			КонецЦикла;
			Индекс = Индекс + 1;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

// Возвращает описание числового типа поля схемы или Неопределено.
Функция ОписаниеЧисловогоТипа(Поле)
	
	Для Каждого ОписаниеТипаПоля Из Поле.types Цикл
		Если ОписаниеТипаПоля.kind = "number" Тогда
			Возврат ОписаниеТипаПоля;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
	
КонецФункции

// Рассчитывает новую цену товара после переоценки.
//
// Параметры:
//  СтараяЦена - Число - цена до переоценки
//  Процент - Число - процент переоценки
//
// Возвращаемое значение:
//  Число - новая цена
//
Функция РассчитатьНовуюЦену(СтараяЦена, Процент) Экспорт
	
	Возврат Окр(СтараяЦена * (1 + Процент / 100), 0, РежимОкругления.Окр15как10);
	
КонецФункции
