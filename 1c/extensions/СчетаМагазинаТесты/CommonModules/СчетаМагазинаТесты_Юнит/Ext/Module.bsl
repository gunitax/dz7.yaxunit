///////////////////////////////////////////////////////////////////////////////////////////////////////
// Юнит-тесты расширения «СчетаМагазина»: только чистые функции, без обращения к базе.
// Уровень задаётся тегом модуля unit, запуск — отдельным конфигом с фильтром по тегу.
///////////////////////////////////////////////////////////////////////////////////////////////////////

Процедура ИсполняемыеСценарии() Экспорт
	
	ЮТТесты.Тег("unit")
		.ДобавитьТестовыйНабор("СчетаМагазина.Идентификаторы")
			.ДобавитьТест("КорректныйИдентификаторРаспознан")
			.ДобавитьТест("НекорректнаяСтрокаДаётНеопределено")
		.ДобавитьТестовыйНабор("СчетаМагазина.ФорматированиеДат")
			.ДобавитьТест("ДатаСтрокойДаётISODateTime")
		.ДобавитьТестовыйНабор("СчетаМагазина.СуммыСтрок")
			.ДобавитьТест("НулевоеКоличествоОшибка")
			.ДобавитьТест("ОтрицательноеКоличествоОшибка")
			.ДобавитьТест("НулеваяЦенаОшибка")
			.ДобавитьТест("ОтрицательнаяЦенаОшибка")
			.ДобавитьТест("СуммаНеСходитсяОшибка")
			.ДобавитьТест("ДопустимоеОкруглениеНеОшибка")
			.ДобавитьТест("НечисловыеЗначенияОшибка")
			.ДобавитьТест("ТочностьЧиселВСообщении")
			.ДобавитьТест("ПроверитьСуммыСобираетПути")
		.ДобавитьТестовыйНабор("СчетаМагазина.ПереоценкаЦен")
			.ДобавитьТест("НоваяЦена_ПроцентВверх")
			.ДобавитьТест("НоваяЦена_ПроцентВнизОкругление");
	
КонецПроцедуры

Процедура КорректныйИдентификаторРаспознан() Экспорт
	
	СтрокаИдентификатора = "0f1b7c1e-1111-4a2b-9c3d-1234567890ab";
	
	Идентификатор = СчетаМагазинаДанные.УникальныйИдентификаторИзСтроки(СтрокаИдентификатора);
	
	ЮТест.ОжидаетЧто(Идентификатор, "Идентификатор распознан")
		.Заполнено();
	ЮТест.ОжидаетЧто(ТипЗнч(Идентификатор), "Тип результата")
		.Равно(Тип("УникальныйИдентификатор"));
	
КонецПроцедуры

Процедура НекорректнаяСтрокаДаётНеопределено() Экспорт
	
	ЮТест.ОжидаетЧто(СчетаМагазинаДанные.УникальныйИдентификаторИзСтроки("не-uuid"), "Невалидная строка")
		.Равно(Неопределено);
	
КонецПроцедуры

Процедура ДатаСтрокойДаётISODateTime() Экспорт
	
	Результат = СчетаМагазинаДанные.ДатаСтрокой(Дата(2026, 11, 10, 12, 34, 56));
	
	ЮТест.ОжидаетЧто(Результат, "Формат ISO 8601")
		.Равно("2026-11-10T12:34:56");
	
КонецПроцедуры

Процедура НулевоеКоличествоОшибка() Экспорт
	
	Ошибки = СчетаМагазинаДанные.ОшибкиСтрокиСумм(0, 10, 0);
	
	Ошибка = ОшибкаПоПолю(Ошибки, "Количество");
	ЮТест.ОжидаетЧто(Ошибка, "Ошибка по количеству")
		.Заполнено();
	ЮТест.ОжидаетЧто(Ошибка.Текст, "Текст ошибки")
		.Содержит("больше нуля");
	
КонецПроцедуры

Процедура ОтрицательноеКоличествоОшибка() Экспорт
	
	Ошибки = СчетаМагазинаДанные.ОшибкиСтрокиСумм(-1, 10, -10);
	
	Ошибка = ОшибкаПоПолю(Ошибки, "Количество");
	ЮТест.ОжидаетЧто(Ошибка, "Ошибка по количеству")
		.Заполнено();
	
КонецПроцедуры

Процедура НулеваяЦенаОшибка() Экспорт
	
	Ошибки = СчетаМагазинаДанные.ОшибкиСтрокиСумм(1, 0, 0);
	
	Ошибка = ОшибкаПоПолю(Ошибки, "Цена");
	ЮТест.ОжидаетЧто(Ошибка, "Ошибка по цене")
