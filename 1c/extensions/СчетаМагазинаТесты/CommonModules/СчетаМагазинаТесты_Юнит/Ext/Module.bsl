КонецПроцедуры

Процедура СуммаНеСходитсяОшибка() Экспорт
	
	Ошибки = СчетаМагазинаДанные.ОшибкиСтрокиСумм(3, 33.33, 100.00);
	
	Ошибка = ОшибкаПоПолю(Ошибки, "Сумма");
	ЮТест.ОжидаетЧто(Ошибка, "Ошибка по сумме")
		.Заполнено();
	ЮТест.ОжидаетЧто(Ошибка.Текст, "Ожидаемая сумма в тексте")
		.Содержит("99,99");
	
КонецПроцедуры

Процедура ДопустимоеОкруглениеНеОшибка() Экспорт
	
	// 0.75 × 33.33 = 24.9975; Окр(24.9975, 2) = 25.00.
	Ошибки = СчетаМагазинаДанные.ОшибкиСтрокиСумм(0.75, 33.33, 25.00);
	
	ЮТест.ОжидаетЧто(Ошибки.Количество(), "Ошибок нет")
		.Равно(0);
	
КонецПроцедуры

Процедура НечисловыеЗначенияОшибка() Экспорт
	
	Ошибки = СчетаМагазинаДанные.ОшибкиСтрокиСумм("3", 10, 30);
	Ошибка = ОшибкаПоПолю(Ошибки, "Количество");
	ЮТест.ОжидаетЧто(Ошибка, "Ошибка по количеству")
		.Заполнено();
	ЮТест.ОжидаетЧто(Ошибка.Текст, "Текст ошибки")
		.Содержит("числом");
	
	Ошибки = СчетаМагазинаДанные.ОшибкиСтрокиСумм(1, "10", 10);
	Ошибка = ОшибкаПоПолю(Ошибки, "Цена");
	ЮТест.ОжидаетЧто(Ошибка, "Ошибка по цене")
		.Заполнено();
	
	Ошибки = СчетаМагазинаДанные.ОшибкиСтрокиСумм(1, 10, "10");
	Ошибка = ОшибкаПоПолю(Ошибки, "Сумма");
	ЮТест.ОжидаетЧто(Ошибка, "Ошибка по сумме")
		.Заполнено();
	
КонецПроцедуры

Процедура ТочностьЧиселВСообщении() Экспорт
	
	Ошибки = СчетаМагазинаДанные.ОшибкиСтрокиСумм(1.2345, 10, 0);
	
	Ошибка = ОшибкаПоПолю(Ошибки, "Сумма");
	ЮТест.ОжидаетЧто(Ошибка, "Ошибка по сумме")
		.Заполнено();
	ЮТест.ОжидаетЧто(Ошибка.Текст, "Количество без потери точности")
		.Содержит("1,2345");
	
КонецПроцедуры

Процедура ПроверитьСуммыСобираетПути() Экспорт
	
	Схема = СхемаСумм("document");
	Подготовлено = Новый Структура("tables", Новый Соответствие);
	Строки = Новый Массив;
	
	Первая = Новый Соответствие;
	Первая.Вставить("Количество", 0);
	Первая.Вставить("Цена", 10);
	Первая.Вставить("Сумма", 0);
	Строки.Добавить(Первая);
	
	Вторая = Новый Соответствие;
	Вторая.Вставить("Количество", 3);
	Вторая.Вставить("Цена", 33.33);
	Вторая.Вставить("Сумма", 100);
	Строки.Добавить(Вторая);
	
	Подготовлено.tables.Вставить("Товары", Строки);
	Ошибки = Новый Массив;
	СчетаМагазинаДанные.ПроверитьСуммы(Подготовлено, Схема, Ошибки);
	
	ЮТест.ОжидаетЧто(Ошибки.Количество(), "Две ошибки")
		.Равно(2);
	ЮТест.ОжидаетЧто(Ошибки[0].path, "Путь первой строки")
		.Равно("tables.Товары[0].Количество");
	ЮТест.ОжидаетЧто(Ошибки[1].path, "Путь второй строки")
		.Равно("tables.Товары[1].Сумма");
	
	ОшибкиКаталога = Новый Массив;
	СчетаМагазинаДанные.ПроверитьСуммы(Подготовлено, СхемаСумм("catalog"), ОшибкиКаталога);
	ЮТест.ОжидаетЧто(ОшибкиКаталога.Количество(), "Справочник не проверяется")
		.Равно(0);
	
КонецПроцедуры

Функция СхемаСумм(Вид)
	
	Поля = Новый Массив;
	Поля.Добавить(ОписаниеПоляСумм("Количество", 3));
	Поля.Добавить(ОписаниеПоляСумм("Цена", 2));
	Поля.Добавить(ОписаниеПоляСумм("Сумма", 2));
	Таблица = Новый Структура("name,writable,fields", "Товары", Истина, Поля);
	Таблицы = Новый Массив;
	Таблицы.Добавить(Таблица);
	
	Возврат Новый Структура("kind,tables", Вид, Таблицы);
	
КонецФункции

Функция ОписаниеПоляСумм(Имя, Знаков)
	
	Типы = Новый Массив;
	Типы.Добавить(Новый Структура("kind,fractionDigits", "number", Знаков));
	Возврат Новый Структура("name,writable,types", Имя, Истина, Типы);
	
КонецФункции

Функция ОшибкаПоПолю(Ошибки, ИмяПоля)
	
	Для Каждого Ошибка Из Ошибки Цикл
		Если Ошибка.Поле = ИмяПоля Тогда
			Возврат Ошибка;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

Процедура НоваяЦена_ПроцентВверх() Экспорт
	
	ЮТест.ОжидаетЧто(СчетаМагазинаДанные.РассчитатьНовуюЦену(100, 7), "Цена +7%")
		.Равно(107);
	
КонецПроцедуры

Процедура НоваяЦена_ПроцентВнизОкругление() Экспорт
	
	ЮТест.ОжидаетЧто(СчетаМагазинаДанные.РассчитатьНовуюЦену(151, -30), "Цена -30%")
		.Равно(106);
	
КонецПроцедуры
