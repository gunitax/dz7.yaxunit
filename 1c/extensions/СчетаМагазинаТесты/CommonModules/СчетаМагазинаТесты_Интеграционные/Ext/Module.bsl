	Товары = Новый Массив;
	ДатаПереоценки = НачалоДня(ТекущаяДатаСеанса()) + 86400;
	СтарыйПериод = КонецДня(ДатаПереоценки - 86400);
	
	Попытка
		Товары.Добавить(СоздатьТовар("ЮТ " + Лев(ЮТест.Данные().УникальнаяСтрока(), 20)));
