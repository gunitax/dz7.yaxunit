///////////////////////////////////////////////////////////////////////////////////////////////////////
// Интеграционные тесты расширения «СчетаМагазина»: работают с базой.
// Уровень задается тегом модуля integration, запуск — отдельным конфигом с фильтром по тегу.
///////////////////////////////////////////////////////////////////////////////////////////////////////

Процедура ИсполняемыеСценарии() Экспорт
	
	ЮТТесты.Тег("integration").УдалениеТестовыхДанных()
		.ДобавитьТестовыйНабор("СчетаМагазина.ЧтениеОбъектов")
			.ДобавитьСерверныйТест("ПрочитатьВозвращаетДанныеОбъекта")
			.ДобавитьСерверныйТест("HTTPДелегатыВозвращаютОтвет")
		.ДобавитьТестовыйНабор("СчетаМагазина.СозданиеСчета")
			.ДобавитьСерверныйТест("СозданиеСНевернойСуммойОтклоняетсяБезЗаписи")
				.ВТранзакции(Ложь)
			.ДобавитьСерверныйТест("СозданиеСВернойСуммойЗаписываетДокумент")
				.ВТранзакции(Ложь);
	
КонецПроцедуры

Процедура ПрочитатьВозвращаетДанныеОбъекта() Экспорт
	
	Наименование = "ЮТ " + Лев(ЮТест.Данные().УникальнаяСтрока(), 20);
	
	Ссылка = ЮТест.Данные().КонструкторОбъекта("Справочник._ДемоПроекты")
		.ФикцияОбязательныхПолей()
		.Установить("Наименование", Наименование)
		.Записать();
	
	Данные = СчетаМагазинаДанные.Прочитать(Метаданные.Справочники._ДемоПроекты, "catalog", Ссылка.УникальныйИдентификатор());
	
	ЮТест.ОжидаетЧто(Данные, "Объект прочитан")
		.Заполнено()
		.Свойство("header.Наименование").Равно(Наименование);
	
	ЮТест.ОжидаетЧтоТаблицаБазы("Справочник._ДемоПроекты")
		.СодержитЗаписи(ЮТест.Предикат().Реквизит("Ссылка").Равно(Ссылка), "Запись найдена в базе");
	
КонецПроцедуры

Процедура HTTPДелегатыВозвращаютОтвет() Экспорт
	
	Ответ = СчетаМагазинаHTTP.НайтиТипы(ЮТест.Данные().HTTPСервисЗапрос());
	ЮТест.ОжидаетЧто(Ответ.КодСостояния, "Реестр типов")
		.Равно(200);
	ЮТест.ОжидаетЧто(ТелоОтвета(Ответ).Получить("types").Количество(), "Реестр не пуст")
		.Больше(0);
	
	Запрос = ЮТест.Данные().HTTPСервисЗапрос()
		.ДобавитьПараметрЗапроса("name", "Документ._ДемоСчетНаОплатуПокупателю");
	Ответ = СчетаМагазинаHTTP.ОписатьТип(Запрос);
	ЮТест.ОжидаетЧто(Ответ.КодСостояния, "Схема типа")
		.Равно(200);
	ЮТест.ОжидаетЧто(ТелоОтвета(Ответ).Получить("type"), "Имя типа")
		.Равно("Документ._ДемоСчетНаОплатуПокупателю");
	
	Запрос = ЮТест.Данные().HTTPСервисЗапрос()
		.ДобавитьПараметрЗапроса("type", "Справочник._ДемоНоменклатура")
		.ДобавитьПараметрЗапроса("q", "1С");
	Ответ = СчетаМагазинаHTTP.НайтиОбъекты(Запрос);
	ЮТест.ОжидаетЧто(Ответ.КодСостояния, "Поиск")
		.Равно(200);
	Элементы = ТелоОтвета(Ответ).Получить("items");
	ЮТест.ОжидаетЧто(Элементы.Количество(), "Найдены элементы")
		.Больше(0);
	
	Запрос = ЮТест.Данные().HTTPСервисЗапрос()
		.ДобавитьПараметрЗапроса("type", "Справочник._ДемоНоменклатура")
		.ДобавитьПараметрЗапроса("id", Элементы[0].Получить("id"));
	Ответ = СчетаМагазинаHTTP.ПрочитатьОбъект(Запрос);
	ЮТест.ОжидаетЧто(Ответ.КодСостояния, "Чтение объекта")
		.Равно(200);
	ЮТест.ОжидаетЧто(ТелоОтвета(Ответ).Получить("header").Получить("Наименование"), "Наименование")
		.Заполнено();
	
КонецПроцедуры

Процедура СозданиеСНевернойСуммойОтклоняетсяБезЗаписи() Экспорт
	
	Комментарий = "ЮТ " + Лев(ЮТест.Данные().УникальнаяСтрока(), 20);
	Ответ = СчетаМагазинаHTTP.СоздатьОбъект(ЗапросСоздания(ТелоСчета(Комментарий, 3, 33.33, 100.00)));
	Созданный = "";
	
	Попытка
		Созданный = ?(Ответ.КодСостояния = 201, ИдентификаторИзОтвета(Ответ), "");
		ЮТест.ОжидаетЧто(Ответ.КодСостояния, "Код ответа")
			.Равно(422);
		Тело = ТелоОтвета(Ответ);
		ЮТест.ОжидаетЧто(Тело.Получить("error").Получить("code"), "Код ошибки")
			.Равно("invalid_amounts");
		Ошибки = Тело.Получить("error").Получить("details");
		ЮТест.ОжидаетЧто(Ошибки.Количество(), "Ошибок в details")
			.Равно(1);
		Деталь = ДетальПоПути(Ошибки, "tables.Товары[0].Сумма");
		ЮТест.ОжидаетЧто(Деталь, "Ошибка по сумме строки")
			.Заполнено();
		ЮТест.ОжидаетЧто(Деталь.Получить("message"), "Ожидаемая сумма в тексте")
			.Содержит("99,99");
		ЮТест.ОжидаетЧтоТаблицаБазы("Документ._ДемоСчетНаОплатуПокупателю")
			.НеСодержитЗаписи(ЮТест.Предикат().Реквизит("Комментарий").Равно(Комментарий), "Счет не записан");
	Исключение
		УдалитьДокументСчетаБезОшибки(Созданный);
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура СозданиеСВернойСуммойЗаписываетДокумент() Экспорт
	
	КомментарийПервого = "ЮТ " + Лев(ЮТест.Данные().УникальнаяСтрока(), 20);
	КомментарийВторого = "ЮТ " + Лев(ЮТест.Данные().УникальнаяСтрока(), 20);
	Первый = "";
	Второй = "";
	
	Попытка
		ОтветПервого = СчетаМагазинаHTTP.СоздатьОбъект(ЗапросСоздания(ТелоСчета(КомментарийПервого, 3, 33.33, 99.99)));
		ЮТест.ОжидаетЧто(ОтветПервого.КодСостояния, "Код ответа на первый счет").Равно(201);
		Первый = ИдентификаторИзОтвета(ОтветПервого);
		ЮТест.ОжидаетЧто(Первый, "Идентификатор первого счета").Заполнено();
		
		ОтветВторого = СчетаМагазинаHTTP.СоздатьОбъект(ЗапросСоздания(ТелоСчета(КомментарийВторого, 2, 10.00, 20.00)));
		ЮТест.ОжидаетЧто(ОтветВторого.КодСостояния, "Код ответа на второй счет").Равно(201);
		Второй = ИдентификаторИзОтвета(ОтветВторого);
		ЮТест.ОжидаетЧто(Второй, "Идентификатор второго счета").Заполнено();
		
		НомерПервого = НомерИзОтвета(ОтветПервого);
		НомерВторого = НомерИзОтвета(ОтветВторого);
		ЮТест.ОжидаетЧто(НомерПервого, "Номер первого счета").Заполнено();
		ЮТест.ОжидаетЧто(НомерВторого, "Номер второго счета").Заполнено();
		ЮТест.ОжидаетЧто(НомерВторого, "Номер второго счета").НеРавно(НомерПервого);
		
		СсылкаПервого = Документы._ДемоСчетНаОплатуПокупателю.ПолучитьСсылку(Новый УникальныйИдентификатор(Первый));
		ЮТест.ОжидаетЧтоТаблицаБазы("Документ._ДемоСчетНаОплатуПокупателю")
			.СодержитЗаписи(ЮТест.Предикат().Реквизит("Ссылка").Равно(СсылкаПервого), "Первый счет записан");
		ОбъектПервого = СсылкаПервого.ПолучитьОбъект();
		ЮТест.ОжидаетЧто(ОбъектПервого.Товары[0].Сумма, "Сумма первой строки").Равно(99.99);
		ЮТест.ОжидаетЧто(ОбъектПервого.Проведен, "Первый документ не проведен").Равно(Ложь);
		ЮТест.ОжидаетЧто(ОбъектПервого.Комментарий, "Комментарий первого").Равно(КомментарийПервого);
	Исключение
		УдалитьДокументСчетаБезОшибки(Первый);
		УдалитьДокументСчетаБезОшибки(Второй);
		ВызватьИсключение;
	КонецПопытки;
	
	УдалитьДокументСчетаБезОшибки(Первый);
	УдалитьДокументСчетаБезОшибки(Второй);
	ЮТест.ОжидаетЧтоТаблицаБазы("Документ._ДемоСчетНаОплатуПокупателю")
		.НеСодержитЗаписи(ЮТест.Предикат().Реквизит("Комментарий").Равно(КомментарийПервого), "Первый счет удален");
	ЮТест.ОжидаетЧтоТаблицаБазы("Документ._ДемоСчетНаОплатуПокупателю")
		.НеСодержитЗаписи(ЮТест.Предикат().Реквизит("Комментарий").Равно(КомментарийВторого), "Второй счет удален");
	
КонецПроцедуры

Функция НомерИзОтвета(Ответ)
	
	Тело = ТелоОтвета(Ответ);
	Если ТипЗнч(Тело) = Тип("Соответствие") Тогда
		Возврат Строка(Тело.Получить("number"));
	КонецЕсли;
	Возврат "";
	
КонецФункции

Функция РеквизитыСчета()
	
	Результат = Новый Структура;
	Результат.Вставить("Организация", ПерваяСсылка(
		"ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник._ДемоОрганизации ГДЕ НЕ ПометкаУдаления"));
	Результат.Вставить("Партнер", ПерваяСсылка(
		"ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник._ДемоПартнеры ГДЕ Клиент И НЕ ПометкаУдаления И НЕ ЭтоГруппа"));
	Результат.Вставить("Валюта", ПерваяСсылка(
		"ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.Валюты ГДЕ НЕ ПометкаУдаления"));
	Результат.Вставить("Ответственный", ПерваяСсылка(
		"ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.Пользователи ГДЕ НЕ ПометкаУдаления И Наименование = ""Администратор"""));
	Результат.Вставить("Подразделение", ПерваяСсылка(
		"ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник._ДемоПодразделения ГДЕ НЕ ПометкаУдаления"));
	Результат.Вставить("Номенклатура", ПерваяСсылка(
		"ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник._ДемоНоменклатура ГДЕ НЕ ПометкаУдаления И НЕ ЭтоГруппа"));
	Возврат Результат;
	
КонецФункции

Функция ПерваяСсылка(ТекстЗапроса)
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	ВызватьИсключение "В демо-базе нет данных для интеграционного теста";
	
КонецФункции

Функция ТелоСчета(Комментарий, Количество, Цена, Сумма)
	
	Реквизиты = РеквизитыСчета();
	
	Заголовок = Новый Соответствие;
	Заголовок.Вставить("Дата", СчетаМагазинаДанные.ДатаСтрокой(ТекущаяДата()));
	Заголовок.Вставить("ВалютаДокумента", Строка(Реквизиты.Валюта.УникальныйИдентификатор()));
	Заголовок.Вставить("Организация", Строка(Реквизиты.Организация.УникальныйИдентификатор()));
	Заголовок.Вставить("Партнер", Строка(Реквизиты.Партнер.УникальныйИдентификатор()));
	Заголовок.Вставить("Ответственный", Строка(Реквизиты.Ответственный.УникальныйИдентификатор()));
	Заголовок.Вставить("Подразделение", Строка(Реквизиты.Подразделение.УникальныйИдентификатор()));
	Заголовок.Вставить("Комментарий", Комментарий);
	
	СтрокаТовара = Новый Соответствие;
	СтрокаТовара.Вставить("Номенклатура", Строка(Реквизиты.Номенклатура.УникальныйИдентификатор()));
	СтрокаТовара.Вставить("Количество", Количество);
	СтрокаТовара.Вставить("Цена", Цена);
	СтрокаТовара.Вставить("Сумма", Сумма);
	СтрокаТовара.Вставить("Всего", Сумма);
	Товары = Новый Массив;
	Товары.Добавить(СтрокаТовара);
	
	Таблицы = Новый Соответствие;
	Таблицы.Вставить("Товары", Товары);
	
	Тело = Новый Соответствие;
	Тело.Вставить("type", "Документ._ДемоСчетНаОплатуПокупателю");
	Тело.Вставить("header", Заголовок);
	Тело.Вставить("tables", Таблицы);
	Возврат Тело;
	
КонецФункции

Функция ЗапросСоздания(Тело)
	
	Возврат ЮТест.Данные().HTTPСервисЗапрос()
		.Метод("POST")
		.ДобавитьЗаголовок("Content-Type", "application/json")
		.УстановитьТелоКакСтрокуJSON(Тело);
	
КонецФункции

Функция ТелоОтвета(Ответ)
	
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
	Результат = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Результат;
	
КонецФункции

Функция ДетальПоПути(Детали, Путь)
	
	Для Каждого Деталь Из Детали Цикл
		Если Деталь.Получить("path") = Путь Тогда
			Возврат Деталь;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
	
КонецФункции

Функция ИдентификаторИзОтвета(Ответ)
	
	Тело = ТелоОтвета(Ответ);
	Если ТипЗнч(Тело) = Тип("Соответствие") Тогда
		Возврат Строка(Тело.Получить("id"));
	КонецЕсли;
	Возврат "";
	
КонецФункции

Процедура УдалитьДокументСчета(Идентификатор)
	
	Если ПустаяСтрока(Идентификатор) Тогда
		Возврат;
	КонецЕсли;
	Ссылка = Документы._ДемоСчетНаОплатуПокупателю.ПолучитьСсылку(Новый УникальныйИдентификатор(Идентификатор));
	Объект = Ссылка.ПолучитьОбъект();
	Если Объект <> Неопределено Тогда
		Объект.Удалить();
	КонецЕсли;
	
КонецПроцедуры

Процедура УдалитьДокументСчетаБезОшибки(Идентификатор)
	
	Попытка
		УдалитьДокументСчета(Идентификатор);
	Исключение
		// Ошибку удаления покажет финальная проверка отсутствия записи.
	КонецПопытки;
	
КонецПроцедуры
